APP_ENV=demo
VITE_API_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+psycopg://huichuang:huichuang_dev@localhost:5432/huichuang
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=inline
S3_ENDPOINT=http://localhost:9000
STORAGE_BACKEND=inline
S3_BUCKET=huichuang-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Keep the key server-side. The browser only talks to FastAPI.
IMAGE_API_BASE_URL=https://your-openai-compatible-endpoint.example.com
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_OUTPUT_DIR=outputs/images
RODIN_OUTPUT_DIR=outputs/rodin
RODIN_NODE_BIN=node
RODIN_SCRIPT_PATH=scripts/rodin-generate.mjs

# Optional text reasoning provider. Keep its credential server-side.
TEXT_API_BASE_URL=https://your-openai-compatible-endpoint.example.com
TEXT_API_KEY=
TEXT_MODEL=gpt-5.6-sol

# Optional search endpoint. The API falls back to the local reference catalog.
SEARCH_API_URL=
SEARCH_API_KEY=

